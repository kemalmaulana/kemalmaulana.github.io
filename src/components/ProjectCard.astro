---
interface Props {
  p: {
    name: string;
    title: string;
    description: string;
    language: string | null;
    url: string;
    stars: number;
    tags: string[];
  };
}

const { p } = Astro.props;
const tags = [...new Set([p.language, ...p.tags].filter(Boolean))] as string[];
---
<a
  href={p.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex h-full flex-col border-[3px] border-ink bg-white p-5 shadow-[6px_6px_0_var(--color-ink)] transition-transform hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0_var(--color-ink)]"
  aria-label={`${p.title} — opens on GitHub`}
>
  <div class="mb-3 flex items-start justify-between gap-3">
    <h4 class="text-lg font-bold">{p.title}</h4>
    <span class="text-sm font-bold group-hover:text-muted" aria-hidden="true">↗</span>
  </div>
  <p class="mb-4 flex-1 text-sm text-muted">{p.description || "No description."}</p>
  <ul class="flex flex-wrap gap-2">
    {tags.map((t) => <li class="border-2 border-ink px-2 py-0.5 text-xs">{t}</li>)}
  </ul>
</a>

---
import Base from "../layouts/Base.astro";
---
<Base title="404 — Page not found">
  <main class="flex min-h-screen flex-col items-center justify-center px-5 text-center">
    <p class="mb-2 text-xs font-bold uppercase tracking-widest text-muted">Error 404</p>
    <h1 class="mb-6 text-4xl font-bold">Page not found</h1>
    <a href="/" class="border-[3px] border-ink bg-accent px-5 py-3 font-bold">Back home</a>
  </main>
</Base>
